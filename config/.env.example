# Copia este archivo a config/.env y completa los valores. NUNCA versionar config/.env.
# Llaves: php tools/make_keys.php

# --- Base de datos (misma BD, dos usuarios) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agente
DB_USER_HOST=%
# Usuario del agente: SELECT/INSERT/UPDATE solo sobre ndb_agent_*
DB_AGENT_USER=agent_rw
DB_AGENT_PASS=
# Usuario de solo lectura (reservado para consultas de solo lectura; hoy ningún paso lo usa)
DB_RO_USER=agent_ro
DB_RO_PASS=
# Solo para tools/migrate.php (crea tablas y usuarios). Puede quitarse después.
DB_ADMIN_USER=root
DB_ADMIN_PASS=
DB_TIMEOUT=10
DB_RO_QUERY_TIMEOUT=30

# --- Tenant inicial ---
AGENT_TENANT_NAME=Agente
AGENT_TIMEZONE=America/Santiago

# --- Seguridad ---
AGENT_VAULT_KEY=
AGENT_LINK_SECRET=
# URL pública base de public/index.php; con ella se arman los enlaces de las dudas
# (desarrollo: http://localhost/agente/public)
AGENT_BASE_URL=http://localhost/agente/public

# --- Ejecución ---
# DRY_RUN=1 fuerza modo de prueba en todos los tenants: no se envía ningún correo (vistas previas en storage/outbox/)
DRY_RUN=1
# Por defecto crons/agent_run.php solo corre por línea de comandos
CRON_WEB_ENABLED=0
CRON_WEB_SECRET=
# CRON_MAX_SECONDS=600
# PROCESS_BATCH=20          # correos que la IA/decisión procesa por corrida
# INGEST_BATCH=50           # mensajes leídos por casilla y carpeta en cada corrida
# RULES_DIR=                # carpeta de reglas (por defecto: reglas/)

# --- Correo de entrada: Gmail API (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de retorno registrada en Google Cloud. Por defecto: AGENT_BASE_URL + /gmail.php
# GOOGLE_REDIRECT_URI=

# --- Filtros previos a la IA (se aplican antes de gastar tokens) ---
# Remitentes o dominios permitidos, separados por coma (ej. cliente.cl,operaciones@x.com)
MAIL_ALLOWED_SENDERS=
# Avisos automáticos que se descartan sin IA
MAIL_DISCARD_SENDERS=
HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10

# --- Adjuntos (lectura sin IA) ---
OCR_ENABLED=1
OCR_LANGS=spa+eng
ATTACH_MAX_PDF_PAGES=2
ATTACH_MAX_IMAGES=4
ATTACH_MAX_BYTES=15000000
# Días que se conserva el original de un adjunto ilegible, una vez resuelto el correo
ATTACH_KEEP_DAYS=7

# --- IA (Anthropic). Sin clave, los correos quedan en cola sin leer ---
ANTHROPIC_API_KEY=
# Precio de lista por millón de tokens (US$), para el control de gasto
AI_PRICE_IN_PER_MTOK=2
AI_PRICE_OUT_PER_MTOK=10
AI_TIMEOUT=120

# --- Correo de salida (dudas). Sin SMTP_HOST solo se generan vistas previas en storage/outbox/ ---
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Agente Supervisor

# --- MCP: conexión con el sistema externo (catálogo de lugares, órdenes, tramos). Ver docs/mcp.md ---
# Vacío = sin sistema externo. 'fake' = datos simulados para pruebas.
MCP_URL=
MCP_TOKEN=
# Máximo de elementos por llamada (el cliente parte el lote en trozos)
MCP_BATCH_MAX=50
MCP_TIMEOUT=30

# --- Respuesta por correo a las dudas (alternativa al enlace) ---
# Casilla a la que llegan los botones mailto: de las dudas (debe estar entre las casillas que lee el agente).
MAIL_REPLY_TO=
# Id (ndb_agent_mailboxes.mailbox_id) de la casilla donde se leen esas respuestas. Vacío = no se leen respuestas por correo.
